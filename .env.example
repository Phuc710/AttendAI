# App
APP_NAME=FaceAttendance
APP_ENV=development
ADMIN_PASSWORD=admin123

# Database
DB_PATH=face_attendance.db

# Camera
# USB: CAMERA_SOURCE=0
# IP:  CAMERA_SOURCE=rtsp://admin:pass@192.168.1.50:554/stream1
CAMERA_SOURCE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
FRAME_SKIP=3

# AI (InsightFace)
MODEL_NAME=buffalo_l
FACE_MATCH_THRESHOLD=0.45
MIN_FACE_SIZE=60
MIN_DET_SCORE=0.5

# Storage
SAVE_UNKNOWN_FACE=true
SAVE_ATTENDANCE_SNAPSHOT=true

# Duplicate Guard
DUPLICATE_TIME_WINDOW=30

# Server
HOST=0.0.0.0
PORT=8000
